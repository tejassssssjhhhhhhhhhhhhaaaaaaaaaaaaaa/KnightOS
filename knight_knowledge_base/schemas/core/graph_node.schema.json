{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knight.os/schemas/core/graph_node.schema.json",
  "title": "Knowledge Graph Node",
  "description": "Metadata for a node in the semantic graph.",
  "type": "object",
  "properties": {
    "memoryId": { "type": "string", "format": "uuid" },
    "domain": { "type": "string" },
    "gravity": { "type": "number", "minimum": 0, "maximum": 1 },
    "metabolicRate": { "type": "string", "enum": ["static", "rare", "slow", "fast", "volatile"] },
    "embedding": {
      "type": "array",
      "items": { "type": "number" },
      "description": "Optional vector representation for semantic search."
    }
  },
  "required": ["memoryId", "domain", "gravity", "metabolicRate"]
}
