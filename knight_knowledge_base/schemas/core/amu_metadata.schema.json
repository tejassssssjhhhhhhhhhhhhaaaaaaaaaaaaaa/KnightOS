{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knight.os/schemas/core/amu_metadata.schema.json",
  "title": "AMU Metadata",
  "description": "Common metadata substrate for every Atomic Memory Unit in Knight Knowledge Base.",
  "type": "object",
  "properties": {
    "memoryId": {
      "type": "string",
      "format": "uuid",
      "description": "Logical identifier for the fact chain."
    },
    "versionId": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this specific version."
    },
    "effectiveAt": {
      "type": "string",
      "format": "date-time",
      "description": "When the fact became true in reality."
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time",
      "description": "When the fact was committed to memory."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Reliability score from 0.0 to 1.0."
    },
    "sourceType": {
      "type": "string",
      "enum": ["direct_input", "sensor", "inference", "third_party"],
      "description": "The origin of the information."
    },
    "sourceLink": {
      "type": "string",
      "pattern": "^knight://evidence/[a-f0-9]{64}(#.*)?$",
      "description": "URI to the evidence artifact (CAID hash)."
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Semantic labels."
    },
    "isLatest": {
      "type": "boolean",
      "description": "Flag for the current state."
    }
  },
  "required": ["memoryId", "versionId", "effectiveAt", "recordedAt", "confidence", "sourceType", "isLatest"]
}
