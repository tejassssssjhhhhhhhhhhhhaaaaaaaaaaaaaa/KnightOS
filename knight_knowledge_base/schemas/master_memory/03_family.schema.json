{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knight.os/schemas/master_memory/03_family.schema.json",
  "title": "Domain 3: Family",
  "type": "object",
  "properties": {
    "metadata": { "$ref": "../core/amu_metadata.schema.json" },
    "content": {
      "type": "object",
      "properties": {
        "personName": { "type": "string" },
        "relationType": { "type": "string", "enum": ["parent", "sibling", "spouse", "child", "ancestor", "descendant"] },
        "biological": { "type": "boolean" },
        "living": { "type": "boolean" },
        "geneticRisks": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["personName", "relationType"]
    }
  },
  "required": ["metadata", "content"]
}
