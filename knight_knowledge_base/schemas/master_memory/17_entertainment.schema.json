{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knight.os/schemas/master_memory/17_entertainment.schema.json",
  "title": "Domain 17: Entertainment",
  "type": "object",
  "properties": {
    "metadata": { "$ref": "../core/amu_metadata.schema.json" },
    "content": {
      "type": "object",
      "properties": {
        "mediaType": { "type": "string", "enum": ["book", "movie", "tv", "game", "music", "art"] },
        "title": { "type": "string" },
        "rating": { "type": "number", "minimum": 0, "maximum": 10 },
        "status": { "type": "string", "enum": ["started", "paused", "finished", "abandoned"] }
      },
      "required": ["mediaType", "title"]
    }
  },
  "required": ["metadata", "content"]
}
