{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knight.os/schemas/master_memory/21_values.schema.json",
  "title": "Domain 21: Values",
  "type": "object",
  "properties": {
    "metadata": { "$ref": "../core/amu_metadata.schema.json" },
    "content": {
      "type": "object",
      "properties": {
        "valueName": { "type": "string" },
        "definition": { "type": "string" },
        "priorityRank": { "type": "integer" }
      },
      "required": ["valueName", "priorityRank"]
    }
  },
  "required": ["metadata", "content"]
}
