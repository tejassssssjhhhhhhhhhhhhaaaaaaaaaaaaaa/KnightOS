{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knight.os/schemas/master_memory/02_biography.schema.json",
  "title": "Domain 2: Biography",
  "type": "object",
  "properties": {
    "metadata": { "$ref": "../core/amu_metadata.schema.json" },
    "content": {
      "type": "object",
      "properties": {
        "epochName": { "type": "string" },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": ["string", "null"], "format": "date" },
        "description": { "type": "string" },
        "location": { "type": "string" },
        "milestones": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["epochName", "startDate"]
    }
  },
  "required": ["metadata", "content"]
}
