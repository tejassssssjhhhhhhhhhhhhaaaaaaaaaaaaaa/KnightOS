{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knight.os/schemas/master_memory/26_lessons_learned.schema.json",
  "title": "Domain 26: Lessons Learned",
  "type": "object",
  "properties": {
    "metadata": { "$ref": "../core/amu_metadata.schema.json" },
    "content": {
      "type": "object",
      "properties": {
        "lesson": { "type": "string" },
        "sourceEventId": { "type": "string", "format": "uuid" },
        "applicability": { "type": "string" }
      },
      "required": ["lesson"]
    }
  },
  "required": ["metadata", "content"]
}
