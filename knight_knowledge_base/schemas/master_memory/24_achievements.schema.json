{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knight.os/schemas/master_memory/24_achievements.schema.json",
  "title": "Domain 24: Achievements",
  "type": "object",
  "properties": {
    "metadata": { "$ref": "../core/amu_metadata.schema.json" },
    "content": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "magnitude": { "type": "number", "minimum": 0, "maximum": 1 },
        "date": { "type": "string", "format": "date" },
        "description": { "type": "string" }
      },
      "required": ["title", "date"]
    }
  },
  "required": ["metadata", "content"]
}
