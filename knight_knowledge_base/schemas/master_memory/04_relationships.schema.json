{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knight.os/schemas/master_memory/04_relationships.schema.json",
  "title": "Domain 4: Relationships",
  "type": "object",
  "properties": {
    "metadata": { "$ref": "../core/amu_metadata.schema.json" },
    "content": {
      "type": "object",
      "properties": {
        "personName": { "type": "string" },
        "connectionStrength": { "type": "number", "minimum": 0, "maximum": 1 },
        "lastInteraction": { "type": "string", "format": "date-time" },
        "role": { "type": "string" },
        "history": { "type": "string" }
      },
      "required": ["personName", "connectionStrength"]
    }
  },
  "required": ["metadata", "content"]
}
