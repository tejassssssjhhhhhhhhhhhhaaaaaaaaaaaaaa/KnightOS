{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knight.os/schemas/master_memory/23_decision_history.schema.json",
  "title": "Domain 23: Decision History",
  "type": "object",
  "properties": {
    "metadata": { "$ref": "../core/amu_metadata.schema.json" },
    "content": {
      "type": "object",
      "properties": {
        "problem": { "type": "string" },
        "optionsConsidered": { "type": "array", "items": { "type": "string" } },
        "choiceMade": { "type": "string" },
        "reasoning": { "type": "string" },
        "outcomeActual": { "type": "string" }
      },
      "required": ["problem", "choiceMade", "reasoning"]
    }
  },
  "required": ["metadata", "content"]
}
