{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knight.os/schemas/master_memory/11_habits.schema.json",
  "title": "Domain 11: Habits",
  "type": "object",
  "properties": {
    "metadata": { "$ref": "../core/amu_metadata.schema.json" },
    "content": {
      "type": "object",
      "properties": {
        "habitName": { "type": "string" },
        "trigger": { "type": "string" },
        "action": { "type": "string" },
        "reward": { "type": "string" },
        "streak": { "type": "integer" },
        "strength": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "required": ["habitName", "strength"]
    }
  },
  "required": ["metadata", "content"]
}
