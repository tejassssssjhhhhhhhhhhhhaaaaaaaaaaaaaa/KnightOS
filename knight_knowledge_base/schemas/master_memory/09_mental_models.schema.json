{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knight.os/schemas/master_memory/09_mental_models.schema.json",
  "title": "Domain 9: Mental Models",
  "type": "object",
  "properties": {
    "metadata": { "$ref": "../core/amu_metadata.schema.json" },
    "content": {
      "type": "object",
      "properties": {
        "modelName": { "type": "string" },
        "definition": { "type": "string" },
        "context": { "type": "string" },
        "maturity": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "required": ["modelName", "definition"]
    }
  },
  "required": ["metadata", "content"]
}
