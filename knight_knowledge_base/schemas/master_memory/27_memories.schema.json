{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knight.os/schemas/master_memory/27_memories.schema.json",
  "title": "Domain 27: Memories",
  "type": "object",
  "properties": {
    "metadata": { "$ref": "../core/amu_metadata.schema.json" },
    "content": {
      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "emotionalValence": { "type": "number", "minimum": -1, "maximum": 1 },
        "sensoryDetails": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["description"]
    }
  },
  "required": ["metadata", "content"]
}
