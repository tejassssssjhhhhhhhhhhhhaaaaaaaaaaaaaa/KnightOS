{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knight.os/schemas/master_memory/16_preferences.schema.json",
  "title": "Domain 16: Preferences",
  "type": "object",
  "properties": {
    "metadata": { "$ref": "../core/amu_metadata.schema.json" },
    "content": {
      "type": "object",
      "properties": {
        "category": { "type": "string" },
        "item": { "type": "string" },
        "value": { "type": ["string", "number", "boolean", "object"] }
      },
      "required": ["category", "item", "value"]
    }
  },
  "required": ["metadata", "content"]
}
