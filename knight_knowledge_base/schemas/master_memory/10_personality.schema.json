{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knight.os/schemas/master_memory/10_personality.schema.json",
  "title": "Domain 10: Personality",
  "type": "object",
  "properties": {
    "metadata": { "$ref": "../core/amu_metadata.schema.json" },
    "content": {
      "type": "object",
      "properties": {
        "trait": { "type": "string" },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "assessmentMethod": { "type": "string" }
      },
      "required": ["trait", "score"]
    }
  },
  "required": ["metadata", "content"]
}
