{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knight.os/schemas/master_memory/14_assets.schema.json",
  "title": "Domain 14: Assets",
  "type": "object",
  "properties": {
    "metadata": { "$ref": "../core/amu_metadata.schema.json" },
    "content": {
      "type": "object",
      "properties": {
        "assetName": { "type": "string" },
        "assetType": { "type": "string", "enum": ["physical", "digital", "intellectual", "financial"] },
        "valuation": { "type": "number" },
        "location": { "type": "string" },
        "ownershipPct": { "type": "number", "minimum": 0, "maximum": 100 }
      },
      "required": ["assetName", "assetType", "valuation"]
    }
  },
  "required": ["metadata", "content"]
}
