{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knight.os/schemas/master_memory/08_health.schema.json",
  "title": "Domain 8: Health",
  "type": "object",
  "properties": {
    "metadata": { "$ref": "../core/amu_metadata.schema.json" },
    "content": {
      "type": "object",
      "properties": {
        "metricType": { "type": "string" },
        "value": { "type": ["number", "string", "object"] },
        "unit": { "type": "string" },
        "condition": { "type": "string" },
        "medications": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["metricType", "value"]
    }
  },
  "required": ["metadata", "content"]
}
