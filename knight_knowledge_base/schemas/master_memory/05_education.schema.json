{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knight.os/schemas/master_memory/05_education.schema.json",
  "title": "Domain 5: Education",
  "type": "object",
  "properties": {
    "metadata": { "$ref": "../core/amu_metadata.schema.json" },
    "content": {
      "type": "object",
      "properties": {
        "institution": { "type": "string" },
        "degree": { "type": "string" },
        "major": { "type": "string" },
        "status": { "type": "string", "enum": ["enrolled", "completed", "paused", "dropped"] },
        "gpa": { "type": "number" },
        "certifications": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["institution", "status"]
    }
  },
  "required": ["metadata", "content"]
}
