{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knight.os/schemas/master_memory/29_knowledge.schema.json",
  "title": "Domain 29: Knowledge",
  "type": "object",
  "properties": {
    "metadata": { "$ref": "../core/amu_metadata.schema.json" },
    "content": {
      "type": "object",
      "properties": {
        "concept": { "type": "string" },
        "summary": { "type": "string" },
        "links": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["concept", "summary"]
    }
  },
  "required": ["metadata", "content"]
}
