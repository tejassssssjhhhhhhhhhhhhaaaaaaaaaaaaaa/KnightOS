{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knight.os/schemas/master_memory/28_documents.schema.json",
  "title": "Domain 28: Documents",
  "type": "object",
  "properties": {
    "metadata": { "$ref": "../core/amu_metadata.schema.json" },
    "content": {
      "type": "object",
      "properties": {
        "fileName": { "type": "string" },
        "fileType": { "type": "string" },
        "caid": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "securityLevel": { "type": "integer", "minimum": 0, "maximum": 4 }
      },
      "required": ["fileName", "caid"]
    }
  },
  "required": ["metadata", "content"]
}
